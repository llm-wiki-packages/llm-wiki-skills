{
  "keywords": [
    "frame",
    "share",
    "guest",
    "video",
    "assets",
    "deck",
    "host:frame.io",
    "host:*.frame.io"
  ],
  "name": "channel-frameio",
  "requires": {
    "bins": [
      {
        "bin": "yt-dlp",
        "source": "https://github.com/yt-dlp/yt-dlp",
        "installers": {
          "brew": "yt-dlp",
          "pip": "yt-dlp"
        }
      }
    ],
    "ops": ">=0.7.0"
  },
  "sandbox_ref": "llm-wiki-packages/llm-wiki-skills:frameio",
  "stages": {
    "harvest": {},
    "process": {}
  },
  "usage": "/channel-frameio ticket=<id>",
  "v": 1,
  "version": "0.1.0",
  "watch": {
    "defaults": {
      "every": "once",
      "harvest": {
        "scope": "domain",
        "assets": "download"
      }
    },
    "dest": "sources/courses/{slug}",
    "note": "`harvest.scope: domain` is MANDATORY: a share's leaves sit under the share host, not under the job's url, so `page` excludes all of them, and `section` does too whenever the url is a folder inside the share rather than its root."
  }
}
