{
  "argument_hint": "ticket=<id> stage=<harvest|process>",
  "description": "Captures a Substack newsletter's archive: lists its posts, splits free from paid, and writes a page per post.",
  "keywords": [
    "newsletter",
    "newsletters",
    "archive",
    "posts",
    "paywall",
    "host:substack.com",
    "host:*.substack.com"
  ],
  "mode": [
    "pipeline"
  ],
  "name": "channel-substack",
  "requires": {
    "credentials": {
      "file": "optional"
    },
    "ops": ">=0.10.0"
  },
  "sandbox_ref": "llm-wiki-packages/llm-wiki-skills:substack",
  "stages": {
    "harvest": {},
    "process": {}
  },
  "usage": "/channel-substack ticket=<id>",
  "v": 1,
  "version": "0.1.0",
  "watch": {
    "defaults": {
      "every": "1d",
      "harvest": {
        "scope": "domain"
      }
    },
    "dest": "sources/newsletters/{slug}",
    "note": "Point it at the archive URL. `harvest.max_age` and `harvest.access` (free|licensed) are the operator's call."
  }
}
