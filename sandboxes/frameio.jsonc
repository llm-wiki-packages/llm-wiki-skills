// frameio: the catalog template for the channel-frameio unit. `skills install`
// validates it, spells every default out and writes it as the unit's
// `sandbox.jsonc`; `sandboxes/frameio.md` is its help prose.
{
  "v": 2,
  "kind": "skill",
  "stages": {
    "harvest": {
      "extends": "harvest",
      // Playwright's browser build, which the capture scripts launch.
      "machine_reads": ["playwright-cache"],
      "network": {
        // Allow-list mode: naming any host denies every other.
        "allow_domain": [
          // The venue: the apex, and the share app, HLS and proxy hosts under it.
          "frame.io",
          "*.frame.io"
        ]
      }
    },
    "process": {"extends": "process"},
    "routine": {"extends": "routine"}
  }
}
