// substack: the catalog template for the channel-substack unit. `skills install`
// validates it, spells every default out and writes it as the unit's
// `sandbox.jsonc`; `sandboxes/substack.md` is its help prose.
{
  "v": 2,
  "kind": "skill",
  "stages": {
    "harvest": {
      "extends": "harvest",
      // Playwright's browser build, which the capture scripts launch.
      "machine_reads": ["playwright-cache"],
      "network": {
        // Allow-list mode: naming any host denies every other.
        "allow_domain": [
          // The venue: the apex, each publication's subdomain and its image CDN.
          "substack.com",
          "*.substack.com",
          "substackcdn.com"
        ]
      }
    },
    "process": {"extends": "process"},
    "routine": {"extends": "routine"}
  }
}
